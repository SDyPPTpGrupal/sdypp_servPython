# Configuración del deploy de ESTA casa.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# Se configura una vez y después `./deploy/deploy.sh desplegar` no necesita nada
# más. El .env no se versiona: cada casa tiene el suyo.
#
# La forma `: "${VAR:=valor}"` asigna sólo si la variable no viene del entorno,
# así se puede pisar un valor puntual sin editar el archivo:
#
#   BALANCEADOR=http://otra:8081 ./deploy/deploy.sh desplegar

# El nombre de esta casa. Sale en cada línea de la bitácora de la réplica
# (python@casa-X) y nombra el archivo de estado. Sin esto se deriva del hostname
# y queda algo como "casa-cachyos-x8664".
: "${CASA:=casa-cambiame}"

# El plano de control del balanceador. OJO: es el puerto de ADMINISTRACIÓN
# (8081), no el público (8080). El público no conoce /admin y devuelve 404.
: "${BALANCEADOR:=http://100.101.15.93:8081}"

# Los dos puertos del blue-green. Los defaults (8080/8081) sirven para cualquier
# casa; hay que cambiarlos sólo si esa máquina ya usa esos puertos para otra cosa
# —por ejemplo la casa que corre el balanceador, que ocupa los dos—.
# : "${PUERTO_BLUE:=8090}"
# : "${PUERTO_GREEN:=8091}"

# El directorio de la casa: el .env con TP_REDIS_URL y las bitácoras.
# : "${DIR_LOCAL:=$HOME/sdypp}"

# Con qué dirección se anuncia al balanceador. Por defecto la resuelve sola con
# `tailscale ip -4`; sólo hace falta si eso no funciona.
# : "${DIRECCION:=100.x.y.z}"
