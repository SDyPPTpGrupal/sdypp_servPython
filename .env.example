# Copiar a .env y completar. El .env NO se versiona: está en el .gitignore.
#
#   cp .env.example .env

# Base compartida. En local, el compose ya apunta al contenedor redis y no hace
# falta tocar nada. En el despliegue real es el nodo de Tailscale donde corre la
# base, y lleva la contraseña adentro:
#   TP_REDIS_URL=redis://:LA_PASSWORD@casa-juan:6379/0
TP_REDIS_URL=redis://redis:6379/0

# Identidad de este nodo. CASA es la casa; HOST_NAME distingue cada réplica dentro
# de la casa, y es lo que da nombre al archivo de bitácora.
CASA=casa-tomas
HOST_NAME_1=casa-tomas-1
HOST_NAME_2=casa-tomas-2

# --- Sólo para el despliegue real ---
# La base compartida corre en la máquina de Nomico, alcanzable por Tailscale:
#   TP_REDIS_URL=redis://:LA_PASSWORD@casa-nomico:6379/0
#
# En el nodo, el .env sólo aporta TP_REDIS_URL: HOST_NAME, CASA y el puerto los
# pasa el deploy.sh en el `docker run`, y pisan lo que haya acá.
#   blue  -> 8080 (la que sirve)
#   green -> 8081 (la nueva, al lado)
